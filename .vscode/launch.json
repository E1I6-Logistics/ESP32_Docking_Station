{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ESP-IDF: JTAG GDB Debug",
            "type": "cppdbg",
            "request": "launch",
            "MIMode": "gdb",
            "miDebuggerPath": "${command:espIdf.getToolchainGdb}",
            "program": "${workspaceFolder}/build/vibe_firmware.elf",
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "setupCommands": [
                { "text": "target remote :3333" },
                { "text": "mon reset halt" },
                { "text": "thb app_main" }
            ]
        }
    ]
}
