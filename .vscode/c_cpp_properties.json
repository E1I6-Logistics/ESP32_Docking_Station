{
    "configurations": [
        {
            "name": "ESP32 (ESP-IDF Clang/GCC)",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/main",
                "${env:IDF_PATH}/components/**"
            ],
            "defines": [
                "ESP_PLATFORM=1",
                "CONFIG_IDF_TARGET_ESP32=1"
            ],
            "cStandard": "c11",
            "cppStandard": "c++17",
            "intelliSenseMode": "windows-gcc-arm",
            "compileCommands": "${workspaceFolder}/build/compile_commands.json"
        }
    ],
    "version": 4
}
